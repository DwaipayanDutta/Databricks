# ============================================================
# Databricks Connector - Environment Configuration Example
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Application ---
APP_NAME=databricks-connector
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Databricks workspace ---
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_ACCOUNT_ID=

# --- Auth mode: pat | oauth | azure_service_principal | managed_identity | bearer ---
AUTH_MODE=pat

# --- Personal Access Token (AUTH_MODE=pat) ---
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- OAuth (AUTH_MODE=oauth) ---
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_OAUTH_TOKEN_URL=
DATABRICKS_OAUTH_SCOPE=all-apis

# --- Azure Service Principal (AUTH_MODE=azure_service_principal) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_ID=2ff814a6-3304-4ab8-85cb-cd0e6f879c1d

# --- Managed Identity (AUTH_MODE=managed_identity) ---
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_IMDS_ENDPOINT=http://169.254.169.254/metadata/identity/oauth2/token

# --- Bearer token (AUTH_MODE=bearer) ---
BEARER_TOKEN=

# --- HTTP client ---
REQUEST_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=10
MAX_RETRIES=3
BACKOFF_FACTOR=0.5

# --- HTTP connection pooling ---
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=30

# --- Circuit breaker ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# --- Caching (optional) ---
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# --- DBFS ---
# /api/v1/dbfs/download buffers the whole file in memory as one JSON
# response; refuse anything larger than this to avoid OOM on a huge file.
DBFS_DOWNLOAD_MAX_BYTES=268435456

# --- CORS ---
CORS_ALLOW_ORIGINS=*

# --- Observability (optional) ---
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=databricks-connector

# --- Security: require callers to send X-API-Key matching this value ---
CONNECTOR_API_KEY=
