# Never ship real credentials or local env files into the image.
.env
.env.*
!.env.example

# VCS / editor
.git
.gitignore
.github

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Test / lint / type-check artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Docs / misc (not needed at runtime)
docs/
README.md
CHANGELOG.md
tests/
